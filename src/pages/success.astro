---
import Layout from "../layouts/Layout.astro";
---

<Layout
  description="Thank you for your donation to Vote Rutherford."
  title="Donation Successful - Vote Rutherford"
>
  <main class="flex-1">
    <!-- Hero Section -->
    <section class="bg-primary py-16 text-white md:py-24">
      <div class="container mx-auto px-4 text-center">
        <h1 class="sorts-mill-goudy mb-4 text-4xl font-bold md:text-6xl">
          Thank You!
        </h1>
        <p class="mx-auto max-w-2xl text-xl opacity-90">
          Your donation to Vote Rutherford has been successfully processed.
        </p>
      </div>
    </section>

    <div class="container mx-auto max-w-4xl px-4 py-12 md:py-20">
      <div class="text-center">
        <h2 class="sorts-mill-goudy text-primary mb-6 text-3xl font-bold">
          Your Support Makes a Difference
        </h2>
        <p class="mb-8 text-lg leading-relaxed text-gray-700">
          Thank you for supporting our mission to empower voters in Rutherford
          County. Your contribution helps us continue our work in researching
          local issues, investigating candidate positions, and educating the
          community.
        </p>
        <div class="space-y-4">
          <p class="text-gray-600">
            If you have any questions about your donation, please contact us.
          </p>
          <a
            href="/"
            class="bg-primary hover:bg-primary/90 inline-block rounded-lg px-6 py-3 text-white transition-colors"
          >
            Return Home
          </a>
        </div>
      </div>
    </div>
  </main>
</Layout>
