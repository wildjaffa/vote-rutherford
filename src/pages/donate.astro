---
import FormInput from "../components/forms/FormInput.astro";
import Button from "../components/Button.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout
  description="Support Vote Rutherford's mission to bridge the gap between voters and local government in Tennessee."
  title="Donate - Support Our Mission"
>
  <main class="flex-1">
    <!-- Hero Section -->
    <section class="bg-primary py-10 text-white md:py-16">
      <div class="container mx-auto px-4 text-center">
        <h1 class="sorts-mill-goudy mb-4 text-4xl font-bold md:text-6xl">
          Support Our Mission
        </h1>
        <p class="mx-auto max-w-2xl text-xl opacity-90">
          Help us continue to research local issues, investigate candidate
          positions, and educate the voters of Rutherford County.
        </p>
      </div>
    </section>

    <div class="container mx-auto max-w-5xl px-4 py-12 md:py-20 lg:px-8">
      <div class="grid items-center gap-12 md:grid-cols-2 lg:gap-16">
        <div
          class="order-first min-w-0 overflow-hidden rounded-4xl bg-gray-50 p-8 shadow-sm md:order-last md:p-10 lg:p-12"
        >
          <div
            class="mx-auto flex flex-col items-center justify-center text-center"
          >
            <h3 class="mb-4 text-xl font-bold text-gray-900">
              Make a Contribution
            </h3>
            <p class="mb-8 text-gray-600">
              Use our secure Stripe checkout to support Vote Rutherford today.
            </p>

            <form id="donation-form" class="w-full max-w-sm min-w-0 space-y-5">
              <fieldset class="min-w-0">
                <legend
                  class="mb-3 block text-left text-sm font-medium text-gray-700"
                >
                  Choose an amount
                </legend>
                <div
                  class="grid min-w-0 grid-cols-2 gap-2 sm:grid-cols-4 lg:grid-cols-5"
                  role="group"
                  aria-label="Donation amount presets"
                >
                  <button
                    type="button"
                    class="amount-option hover:border-secondary hover:text-secondary focus:ring-secondary min-w-0 cursor-pointer rounded-lg border border-gray-300 bg-white px-2 py-2 font-semibold text-gray-700 transition-colors focus:ring-2 focus:outline-none"
                    data-amount="3"
                    aria-pressed="false"
                  >
                    $3
                  </button>
                  <button
                    type="button"
                    class="amount-option border-secondary bg-secondary hover:bg-secondary/90 focus:ring-secondary min-w-0 cursor-pointer rounded-lg border px-2 py-2 font-semibold text-white transition-colors focus:ring-2 focus:outline-none"
                    data-amount="5"
                    aria-pressed="true"
                  >
                    <span aria-hidden="true">★ </span>$5
                  </button>
                  <button
                    type="button"
                    class="amount-option hover:border-secondary hover:text-secondary focus:ring-secondary min-w-0 cursor-pointer rounded-lg border border-gray-300 bg-white px-2 py-2 font-semibold text-gray-700 transition-colors focus:ring-2 focus:outline-none"
                    data-amount="10"
                    aria-pressed="false"
                  >
                    $10
                  </button>
                  <button
                    type="button"
                    class="amount-option hover:border-secondary hover:text-secondary focus:ring-secondary min-w-0 cursor-pointer rounded-lg border border-gray-300 bg-white px-2 py-2 font-semibold text-gray-700 transition-colors focus:ring-2 focus:outline-none"
                    data-amount="25"
                    aria-pressed="false"
                  >
                    $25
                  </button>
                  <button
                    type="button"
                    class="amount-option hover:border-secondary hover:text-secondary focus:ring-secondary col-span-2 w-full min-w-0 cursor-pointer justify-self-center rounded-lg border border-gray-300 bg-white px-2 py-2 font-semibold text-gray-700 transition-colors focus:ring-2 focus:outline-none sm:col-start-2 lg:col-span-1 lg:col-start-auto"
                    data-amount="custom"
                    aria-pressed="false"
                  >
                    Custom
                  </button>
                </div>
              </fieldset>
              <div id="custom-amount-field" class="hidden">
                <FormInput
                  name="amount"
                  label="Custom amount ($)"
                  type="number"
                  min="1"
                  step="0.01"
                  required
                />
              </div>
              <Button type="submit" id="donate-btn" class="w-full"
                >Donate Now</Button
              >
            </form>

            <p class="mt-6 text-sm text-gray-500">
              Payments are securely processed by Stripe.
            </p>
          </div>
        </div>

        <div class="space-y-6">
          <h2 class="sorts-mill-goudy text-primary text-3xl font-bold">
            Why Donate?
          </h2>
          <div class="space-y-4 text-lg leading-relaxed text-gray-700">
            <p>
              Local elections frequently suffer from low voter turnout and
              limited public awareness of candidates’ backgrounds and policy
              positions.
            </p>
            <p>
              <strong class="text-primary">Vote Rutherford</strong> is a centralized,
              user-friendly platform aiming to empower voters with the knowledge they
              need before they head to the ballot box.
            </p>
            <p>Your contribution, no matter what size, helps us:</p>
            <ul class="list-inside list-disc space-y-2 pl-2">
              <li>Conduct scientific, impartial polling and research</li>
              <li>Keep our platform free and open for the community</li>
              <li>Maintain and expand our outreach efforts</li>
            </ul>
            <p class="font-medium">
              Thank you for trusting us to be your non-partisan resource for
              local elections.
            </p>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script>
  (() => {
    const donationForm = document.getElementById(
      "donation-form",
    ) as HTMLFormElement;
    if (!donationForm) {
      console.error("Donation form not found");
      return;
    }

    const amountInput = document.getElementById("amount") as HTMLInputElement;
    const amountOptions =
      document.querySelectorAll<HTMLButtonElement>(".amount-option");
    const customAmountField = document.getElementById("custom-amount-field");

    const updateSelectedAmount = (selectedAmount: string) => {
      amountOptions.forEach((option) => {
        const isSelected = option.dataset.amount === selectedAmount;
        option.setAttribute("aria-pressed", String(isSelected));
        option.classList.toggle("bg-secondary", isSelected);
        option.classList.toggle("text-white", isSelected);
        option.classList.toggle("border-secondary", isSelected);
        option.classList.toggle("bg-white", !isSelected);
        option.classList.toggle("text-gray-700", !isSelected);
        option.classList.toggle("border-gray-300", !isSelected);
      });
    };

    const showCustomAmount = () => {
      if (!amountInput || !customAmountField) return;

      customAmountField.classList.remove("hidden");
      amountInput.value = "";
      updateSelectedAmount("custom");
      amountInput.focus();
    };

    amountOptions.forEach((option) => {
      option.addEventListener("click", () => {
        const amount = option.dataset.amount;
        if (!amountInput || !amount) return;

        if (amount === "custom") {
          showCustomAmount();
          return;
        }

        amountInput.value = amount;
        customAmountField?.classList.add("hidden");
        updateSelectedAmount(amount);
      });
    });

    amountInput?.addEventListener("input", () => {
      updateSelectedAmount("custom");
    });

    donationForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!amountInput) {
        console.error("Amount input not found");
        alert("An error occurred. Please try again.");
        return;
      }

      const amount = parseFloat((amountInput as HTMLInputElement).value);
      if (isNaN(amount) || amount < 1) {
        alert("Please enter a valid amount of at least $1.");
        return;
      }
      const payload = JSON.stringify({ amount: Math.round(amount * 100) });
      console.log("Submitting donation:", payload);
      try {
        const response = await fetch("/api/create-checkout-session", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: payload,
        });
        const data = await response.json();
        if (!response.ok) {
          alert(data.error || "An error occurred");
          return;
        }
        window.location.href = data.url;
      } catch (error) {
        console.error("Error:", error);
        alert("An error occurred while processing your request.");
      }
    });
  })();
</script>
