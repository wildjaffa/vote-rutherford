---
import Layout from "../../../../layouts/Layout.astro";
import CandidateCard from "../../../../components/CandidateCard.astro";
import prisma from "../../../../lib/prisma";
import BackOption from "../../../../components/BackOption.astro";
import CandidateProfilePicture from "../../../../components/CandidateProfilePicture.astro";
import PlaceholderCandidateCard from "../../../../components/PlaceholderCandidateCard.astro";
import MarkdownIt from "markdown-it";
import { Square, SquareCheck } from "../../../../lib/icons";

export const prerender = false;

const { election, race } = Astro.params;

if (!election || !race) {
  return Astro.redirect("/404");
}

const raceData = await prisma.race.findFirst({
  where: {
    slug: race,
    election: { slug: election },
  },
  include: {
    election: { include: { policyQuestions: true } },
    candidates: {
      where: {
        deletedAt: null,
      },
      include: {
        profileImage: true,
        policyResponses: {
          include: {
            clarifications: true,
          },
        },
      },
    },
    sourceRaces: {
      include: {
        election: true,
        candidates: {
          where: { isWinner: true, deletedAt: null },
        },
      },
    },
  },
});

if (raceData === null) {
  return Astro.redirect("/404");
}

const initiativeMarkdown = new MarkdownIt({
  html: false,
  linkify: true,
  breaks: true,
});
initiativeMarkdown.disable("image");
const initiativeDetailsHtml = raceData.initiativeDetails
  ? initiativeMarkdown.render(raceData.initiativeDetails)
  : "";

const questions = raceData.election.policyQuestions;
const { candidates, sourceRaces } = raceData;

// A source race is pending if it has no winners marked
const pendingSourceRaces = sourceRaces.filter(
  (sr) => sr.candidates.length === 0,
);

// Serialize to JSON for client-side script
const candidatesJson = JSON.stringify(
  candidates.map((c) => ({
    id: c.id,
    firstName: c.firstName,
    lastName: c.lastName,
    policyResponses: c.policyResponses.map((r) => ({
      policyQuestionId: r.policyQuestionId,
      response: r.response,
      clarifications: r.clarifications.map((cl) => ({
        clarification: cl.clarification,
        clarificationReceivedAt: cl.clarificationReceivedAt,
      })),
    })),
  })),
);

const questionsJson = JSON.stringify(
  questions.map((q) => ({
    id: q.id,
    questionText: q.questionText,
    descriptionText: q.descriptionText,
  })),
);

const noIncumbent = candidates.filter((c) => c.isIncumbent).length === 0;
---

<Layout
  description={`Compare policy positions and qualifications for candidates in the ${raceData.name} for the ${raceData.election.name} in Rutherford County. Make an informed voting choice.`}
  title={`${raceData.name} Candidate Comparison`}
>
  <BackOption href="/my-ballot" text="Back to Your Ballot" />
  <main class="container mx-auto flex-1 px-4 py-8">
    <div class="mb-12">
      <h1 class="mb-4 text-4xl font-bold text-gray-900">{raceData.name}</h1>
      <p class="max-w-3xl text-xl text-gray-600">
        {raceData.votingMethod === "INITIATIVE"
          ? raceData.initiativeSummary ||
            "This measure asks voters to approve or reject a proposed change."
          : raceData.description}
      </p>
      {
        raceData.numSelections > 1 && (
          <p class="mt-4 inline-block rounded-lg bg-blue-50 px-4 py-2 text-blue-800">
            <strong>Note:</strong> In this race, you can select up to{" "}
            <strong>{raceData.numSelections}</strong> candidates.
          </p>
        )
      }
    </div>

    <section class="mb-16">
      {
        raceData.votingMethod === "INITIATIVE" ? (
          <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
            <h2 class="mb-4 text-2xl font-semibold text-gray-900">Ballot Measure Details</h2>
            {initiativeDetailsHtml && (
              <div class="initiative-markdown mb-6 max-w-4xl text-gray-800" set:html={initiativeDetailsHtml} />
            )}
            {raceData.description && (
              <details class="mb-6 border-y border-gray-200 py-3">
                <summary class="cursor-pointer font-semibold text-secondary">
                  Read full official ballot language
                </summary>
                <p class="mt-3 max-w-4xl whitespace-pre-wrap leading-relaxed text-gray-800">
                  {raceData.description}
                </p>
              </details>
            )}
            <h3 class="mb-3 text-lg font-semibold text-gray-900">Choose your vote</h3>
            <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
              <button
                type="button"
                class="initiative-vote-choice flex w-full items-start justify-between gap-4 rounded-lg border border-green-200 bg-green-50 p-4 text-left transition-colors hover:bg-green-100 focus:ring-2 focus:ring-green-700 focus:outline-none"
                data-choice="approve"
                data-candidate-id={`${raceData.id}_approve`}
                aria-pressed="false"
              >
                <span>
                  <span class="mb-1 block text-lg font-bold text-green-900">A "YES / APPROVE" Vote Means:</span>
                  <span class="block text-sm leading-relaxed text-green-800">
                    {raceData.approvalDescription || "Approve or support this measure."}
                  </span>
                </span>
                <span class="shrink-0 text-green-800" aria-hidden="true">
                  <span class="unselected-icon"><Square class="h-6 w-6" /></span>
                  <span class="selected-icon hidden"><SquareCheck class="h-6 w-6" /></span>
                </span>
              </button>
              <button
                type="button"
                class="initiative-vote-choice flex w-full items-start justify-between gap-4 rounded-lg border border-red-200 bg-red-50 p-4 text-left transition-colors hover:bg-red-100 focus:ring-2 focus:ring-red-700 focus:outline-none"
                data-choice="deny"
                data-candidate-id={`${raceData.id}_deny`}
                aria-pressed="false"
              >
                <span>
                  <span class="mb-1 block text-lg font-bold text-red-900">A "NO / DENY" Vote Means:</span>
                  <span class="block text-sm leading-relaxed text-red-800">
                    {raceData.disapprovalDescription || "Deny or oppose this measure."}
                  </span>
                </span>
                <span class="shrink-0 text-red-800" aria-hidden="true">
                  <span class="unselected-icon"><Square class="h-6 w-6" /></span>
                  <span class="selected-icon hidden"><SquareCheck class="h-6 w-6" /></span>
                </span>
              </button>
            </div>
            <p id="initiative-choice-status" class="mt-3 text-sm text-gray-600" aria-live="polite"></p>
          </div>
        ) : (
          <>
            <h2 class="mb-6 text-2xl font-semibold text-gray-900">Candidates</h2>
            {
              candidates.length > 0 || pendingSourceRaces.length > 0 ? (
                <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
                  {candidates.map((candidate) => (
                    <CandidateCard
                      candidate={candidate}
                      profileImage={candidate.profileImage}
                      raceSlug={raceData.slug}
                      electionSlug={raceData.election.slug}
                      subtext={
                        noIncumbent
                          ? "Open Seat"
                          : candidate.isIncumbent
                            ? "Incumbent"
                            : ""
                      }
                    />
                  ))}

                  {/* Show pending placeholders for source races without winners */}
                  {pendingSourceRaces.map((sr) => (
                    <PlaceholderCandidateCard
                      sourceRaceName={`${sr.name} (${sr.election.name})`}
                    />
                  ))}
                </div>
              ) : (
                <p class="text-gray-500 italic">No candidates found for this race.</p>
              )
            }
          </>
        )
      }
    </section>

    {
      questions.length > 0 && candidates.length > 0 && (
        <section>
          <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
            <h2 class="text-2xl font-semibold text-gray-900">
              Policy Comparison
            </h2>
            <p class="text-sm text-gray-500">
              Select candidates below to compare their positions.
            </p>
          </div>

          {/* Candidate selector chips */}
          <div id="candidate-selector" class="mb-8 flex flex-wrap gap-3">
            {candidates.map((candidate) => (
              <button
                type="button"
                data-candidate-id={candidate.id}
                class="candidate-chip hover:border-accent hover:text-accent flex items-center gap-2 rounded-full border-2 border-gray-200 bg-white px-4 py-2 text-sm font-medium text-gray-600 shadow-sm transition-all duration-200 focus:outline-none"
                aria-pressed="false"
              >
                <span class="chip-avatar flex h-6 w-6 shrink-0 items-center justify-center overflow-hidden rounded-full bg-gray-200 text-xs text-gray-400">
                  <CandidateProfilePicture candidate={candidate} />
                </span>
                <span>
                  {candidate.firstName} {candidate.lastName}
                </span>
                <span class="chip-check text-accent hidden">✓</span>
              </button>
            ))}
          </div>

          {/* Empty-state notice when no candidate selected */}
          <div
            id="no-selection-notice"
            class="mb-8 rounded-xl border border-dashed border-gray-300 bg-gray-50 p-8 text-center text-gray-500"
          >
            Select one or more candidates above to view their policy positions.
          </div>

          {/* Questions rendered by client-side JS */}
          <div id="questions-container" class="hidden space-y-12" />

          {/* Pre-rendered avatar templates for use by client-side JS */}
          {candidates.map((candidate) => (
            <template id={`avatar-${candidate.id}`}>
              <CandidateProfilePicture
                candidate={candidate}
                profileImage={candidate.profileImage}
              />
            </template>
          ))}
        </section>
      )
    }
  </main>
</Layout>

<script is:inline define:vars={{ candidatesJson, questionsJson }} type="module">
  /** @type {Array} */
  const candidates = JSON.parse(candidatesJson);
  /** @type {Array} */
  const questions = JSON.parse(questionsJson);

  /** @type {Set<string>} */
  const selected = new Set();

  const chips = document.querySelectorAll(".candidate-chip");
  const notice = document.getElementById("no-selection-notice");
  const container = document.getElementById("questions-container");

  // ── Helpers ────────────────────────────────────────────────────────────────

  function avatarHtml(c) {
    const tpl = /** @type {HTMLTemplateElement|null} */ (
      document.getElementById(`avatar-${c.id}`)
    );
    if (!tpl) return "";
    const div = document.createElement("div");
    div.appendChild(tpl.content.cloneNode(true));
    return div.innerHTML;
  }

  function clarificationsHtml(clarifications) {
    if (!clarifications || clarifications.length === 0) return "";
    return `
      <div class="mt-3 space-y-2 border-t border-gray-200 pt-3">
        <p class="text-xs font-semibold tracking-wider text-gray-500 uppercase">Clarifications</p>
        ${clarifications
          .map(
            (cl) => `
          <div class="rounded-md bg-blue-50 p-3 text-sm leading-relaxed text-blue-900 whitespace-pre-wrap">
            ${cl.clarification}
          </div>`,
          )
          .join("")}
      </div>`;
  }

  function buildQuestions() {
    if (!container) return;
    container.innerHTML = "";

    const activeCandidates = candidates.filter((c) => selected.has(c.id));

    questions.forEach((q) => {
      const responseCols = activeCandidates
        .map((c) => {
          const resp = c.policyResponses.find(
            (r) => r.policyQuestionId === q.id,
          );
          return `
          <div class="flex flex-col rounded-lg bg-gray-50 p-4">
            <div class="mb-3 flex items-center gap-3">
              <div class="h-8 w-8 shrink-0 overflow-hidden rounded-full bg-gray-200">
                ${avatarHtml(c)}
              </div>
              <span class="font-semibold text-gray-900">${c.firstName} ${c.lastName}</span>
            </div>
            ${
              resp
                ? `<p class="text-sm leading-relaxed text-gray-800 whitespace-pre-wrap">${resp.response}</p>
                   ${clarificationsHtml(resp.clarifications)}`
                : `<p class="text-sm text-gray-500 italic">No response provided.</p>`
            }
          </div>`;
        })
        .join("");

      const colClass =
        activeCandidates.length === 1
          ? "grid-cols-1"
          : activeCandidates.length === 2
            ? "grid-cols-1 sm:grid-cols-2"
            : activeCandidates.length === 3
              ? "grid-cols-1 sm:grid-cols-2 lg:grid-cols-3"
              : "grid-cols-1 sm:grid-cols-2 lg:grid-cols-2 xl:grid-cols-4";

      const card = document.createElement("div");
      card.className =
        "overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm";
      card.innerHTML = `
        <div class="border-b border-gray-200 bg-gray-50 p-6">
          <h3 class="text-xl font-bold text-gray-900 whitespace-pre-wrap">${q.questionText}</h3>
          ${q.descriptionText ? `<p class="mt-2 text-gray-600 whitespace-pre-wrap">${q.descriptionText}</p>` : ""}
        </div>
        <div class="grid gap-4 p-6 ${colClass}">
          ${responseCols}
        </div>`;
      container.appendChild(card);
    });
  }

  function refresh() {
    const hasSelection = selected.size > 0;

    if (notice) notice.classList.toggle("hidden", hasSelection);
    if (container) container.classList.toggle("hidden", !hasSelection);

    if (hasSelection) buildQuestions();
  }

  // ── Event listeners ────────────────────────────────────────────────────────

  chips.forEach((chip) => {
    chip.addEventListener("click", () => {
      const id = chip.dataset.candidateId;
      if (!id) return;

      const nowSelected = !selected.has(id);
      if (nowSelected) {
        selected.add(id);
      } else {
        selected.delete(id);
      }

      chip.setAttribute("aria-pressed", String(nowSelected));
      chip.classList.toggle("border-accent", nowSelected);
      chip.classList.toggle("bg-accent/10", nowSelected);
      chip.classList.toggle("text-accent", nowSelected);
      chip.classList.toggle("border-gray-200", !nowSelected);
      chip.classList.toggle("bg-white", !nowSelected);
      chip.classList.toggle("text-gray-600", !nowSelected);

      const check = chip.querySelector(".chip-check");
      if (check) check.classList.toggle("hidden", !nowSelected);

      refresh();
    });
  });

  // Initial state
  refresh();
</script>

<script>
  const initInitiativeVoteChoices = () => {
    const buttons = document.querySelectorAll<HTMLButtonElement>(
      ".initiative-vote-choice",
    );
    if (buttons.length === 0) return;
    if (buttons[0]?.dataset.voteChoiceInitialized === "true") return;
    if (buttons[0]) buttons[0].dataset.voteChoiceInitialized = "true";

    const storageKey = "vote_plan_selections";
    const firstId = buttons[0]?.dataset.candidateId;
    const raceId = firstId?.replace(/_(approve|deny)$/, "");
    const status = document.getElementById("initiative-choice-status");
    if (!raceId) return;

    const readSelections = (): Record<string, string[]> => {
      try {
        return JSON.parse(localStorage.getItem(storageKey) || "{}");
      } catch {
        return {};
      }
    };

    const render = () => {
      const selectedIds = readSelections()[raceId] || [];
      buttons.forEach((button) => {
        const selected = selectedIds.includes(button.dataset.candidateId || "");
        button.setAttribute("aria-pressed", String(selected));
        button.classList.toggle("ring-2", selected);
        button.classList.toggle("ring-offset-2", selected);
        button.classList.toggle(
          "ring-green-700",
          selected && button.dataset.choice === "approve",
        );
        button.classList.toggle(
          "ring-red-700",
          selected && button.dataset.choice === "deny",
        );
        button.querySelector(".unselected-icon")?.classList.toggle("hidden", selected);
        button.querySelector(".selected-icon")?.classList.toggle("hidden", !selected);
      });

      const selectedChoice = Array.from(buttons).find((button) =>
        selectedIds.includes(button.dataset.candidateId || ""),
      )?.dataset.choice;
      if (status) {
        status.textContent = selectedChoice
          ? `Your vote plan: ${selectedChoice === "approve" ? "For / Approve" : "Against / Deny"}.`
          : "No vote selected yet.";
      }
    };

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const candidateId = button.dataset.candidateId;
        const choice = button.dataset.choice;
        if (!candidateId || !choice) return;

        const selections = readSelections();
        const selectedIds = selections[raceId] || [];
        if (selectedIds.includes(candidateId)) {
          selections[raceId] = selectedIds.filter((id) => id !== candidateId);
        } else {
          const oppositeChoice = choice === "approve" ? "deny" : "approve";
          const oppositeId = `${raceId}_${oppositeChoice}`;
          selections[raceId] = [
            ...selectedIds.filter((id) => id !== oppositeId),
            candidateId,
          ];
        }

        localStorage.setItem(storageKey, JSON.stringify(selections));
        render();
      });
    });

    window.addEventListener("storage", (event) => {
      if (event.key === storageKey) render();
    });

    render();
  };

  initInitiativeVoteChoices();
  document.addEventListener("astro:page-load", initInitiativeVoteChoices);
</script>

<style>
  :global(.initiative-markdown h2) {
    margin: 1.5rem 0 0.5rem;
    font-size: 1.25rem;
    font-weight: 700;
    color: #111827;
  }

  :global(.initiative-markdown h3) {
    margin: 1.25rem 0 0.5rem;
    font-size: 1.125rem;
    font-weight: 700;
    color: #111827;
  }

  :global(.initiative-markdown p) {
    margin: 0.5rem 0;
    line-height: 1.6;
  }

  :global(.initiative-markdown ul),
  :global(.initiative-markdown ol) {
    margin: 0.5rem 0 0.75rem;
    padding-left: 1.5rem;
  }

  :global(.initiative-markdown ul) {
    list-style: disc;
  }

  :global(.initiative-markdown ol) {
    list-style: decimal;
  }

  :global(.initiative-markdown a) {
    color: #b42332;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .custom-scrollbar::-webkit-scrollbar {
    width: 6px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background-color: #e5e7eb;
    border-radius: 20px;
  }
</style>
