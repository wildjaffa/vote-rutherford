---
import Layout from "../layouts/Layout.astro";
import prisma from "../lib/prisma";
import { getUpcomingElections } from "../lib/services/elections";
import {
  formatCalendarDate,
  toCalendarDateString,
} from "../lib/services/signLogistics";
import { formatVoterAddress } from "../lib/utils/formatVoterAddress";

export const prerender = false;

const [sites, upcomingElections] = await Promise.all([
  prisma.site.findMany({
    where: { deletedAt: null },
    include: {
      voterAddress: {
        select: { address: true, city: true, zip: true },
      },
    },
    orderBy: { name: "asc" },
  }),
  getUpcomingElections(),
]);

const nextElection = upcomingElections[0] ?? null;
const earlyVotingSites = sites.filter((site) => site.type === "EARLY_VOTING");
const electionDaySites = sites.filter((site) => site.type === "DAY_OF_VOTING");

function formatAddress(site: (typeof sites)[number]): string {
  const { address, city, zip } = site.voterAddress;
  return formatVoterAddress(address, city, zip);
}

function formatMapUrl(site: (typeof sites)[number]): string {
  const query = `${site.name}, ${formatAddress(site)}`;
  return `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(query)}`;
}

function formatDate(date: Date): string {
  return formatCalendarDate(toCalendarDateString(date));
}
---

<Layout
  description="Find early voting and Election Day polling locations in Rutherford County, Tennessee."
  title="Rutherford County Voting Locations"
>
  <main class="mx-auto max-w-5xl px-4 py-8">
    <header class="mb-10 text-center">
      <h1 class="mb-4 text-4xl font-bold text-gray-900">Voting Locations</h1>
      <p class="mx-auto max-w-3xl text-lg text-gray-600">
        Find polling locations for early voting and Election Day in Rutherford
        County.
      </p>
      {
        nextElection && (
          <p class="mt-3 text-sm font-medium text-gray-700">
            Dates for {nextElection.name}
          </p>
        )
      }
    </header>

    <div class="space-y-10">
      <section aria-labelledby="early-voting-heading">
        <h2
          id="early-voting-heading"
          class="text-primary mb-4 border-b border-primary/20 pb-2 text-2xl font-semibold"
        >
          Early Voting
        </h2>
        <p class="mb-4 text-gray-600">
          {
            nextElection?.earlyVotingStart && nextElection.earlyVotingEnd
              ? `${formatDate(nextElection.earlyVotingStart)} – ${formatDate(nextElection.earlyVotingEnd)}`
              : "Early voting dates have not been announced."
          }
        </p>
        <p class="mb-4">
          <a
            href="https://rutherfordcountytn.gov/early-voting"
            target="_blank"
            rel="noopener noreferrer"
            class="text-secondary underline underline-offset-2 transition-colors hover:text-primary focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-secondary"
          >
            Official Rutherford County early voting information
            <span class="sr-only"> (opens in a new tab)</span>
          </a>
        </p>
        {
          earlyVotingSites.length > 0 ? (
            <ul class="grid grid-cols-1 gap-4 md:grid-cols-2">
              {earlyVotingSites.map((site) => (
                <li class="group flex h-full transform-gpu flex-col rounded-lg border border-gray-200 bg-white p-5 shadow-sm transition-transform hover:-translate-y-1 hover:shadow-lg">
                  <h3 class="group-hover:text-secondary text-lg font-semibold text-gray-900 transition-colors">
                    {site.name}
                  </h3>
                  <a
                    href={formatMapUrl(site)}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-secondary mt-2 inline-block underline underline-offset-2 transition-colors hover:text-primary focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-secondary"
                  >
                    {formatAddress(site)}
                    <span class="sr-only"> (opens in Google Maps)</span>
                  </a>
                  {site.description && (
                    <p class="mt-3 whitespace-pre-line text-sm text-gray-600">
                      {site.description}
                    </p>
                  )}
                </li>
              ))}
            </ul>
          ) : (
            <p class="rounded-lg border border-primary/10 bg-primary/5 p-5 text-gray-600">
              No early voting locations are currently listed.
            </p>
          )
        }
      </section>

      <section aria-labelledby="election-day-heading">
        <h2
          id="election-day-heading"
          class="text-secondary mb-4 border-b border-secondary/20 pb-2 text-2xl font-semibold"
        >
          Election Day
        </h2>
        <p class="mb-4 text-gray-600">
          {nextElection ? formatDate(nextElection.date) : "Election date not available."}
        </p>
        <p class="mb-4 text-gray-600">
          Election Day polling locations are open from 7:00 AM to 7:00 PM.
        </p>
        <p class="mb-4">
          <a
            href="https://rutherfordcountytn.gov/voting-centers"
            target="_blank"
            rel="noopener noreferrer"
            class="text-secondary underline underline-offset-2 transition-colors hover:text-primary focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-secondary"
          >
            Official Rutherford County voting centers
            <span class="sr-only"> (opens in a new tab)</span>
          </a>
        </p>
        {
          electionDaySites.length > 0 ? (
            <ul class="grid grid-cols-1 gap-4 md:grid-cols-2">
              {electionDaySites.map((site) => (
                <li class="group flex h-full transform-gpu flex-col rounded-lg border border-gray-200 bg-white p-5 shadow-sm transition-transform hover:-translate-y-1 hover:shadow-lg">
                  <h3 class="group-hover:text-secondary text-lg font-semibold text-gray-900 transition-colors">
                    {site.name}
                  </h3>
                  <a
                    href={formatMapUrl(site)}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-secondary mt-2 inline-block underline underline-offset-2 transition-colors hover:text-primary focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-secondary"
                  >
                    {formatAddress(site)}
                    <span class="sr-only"> (opens in Google Maps)</span>
                  </a>
                  {site.description && (
                    <p class="mt-3 whitespace-pre-line text-sm text-gray-600">
                      {site.description}
                    </p>
                  )}
                </li>
              ))}
            </ul>
          ) : (
            <p class="rounded-lg border border-secondary/10 bg-secondary/5 p-5 text-gray-600">
              No Election Day locations are currently listed.
            </p>
          )
        }
      </section>
    </div>
  </main>
</Layout>
